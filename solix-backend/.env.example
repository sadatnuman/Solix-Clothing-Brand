PORT=3000
MONGODB_URI=mongodb+srv://DATABASE_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/solix?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:3001

# Optional Send Money recipient numbers. Leave blank to hide that checkout method.
BKASH_NUMBER=
NAGAD_NUMBER=

# Used only by `npm run seed` to create the first studio administrator.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-8-characters

